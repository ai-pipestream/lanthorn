#!/bin/sh
# Hard gate: keep COMPLETED.md and the commit message in lockstep.
#   1. No duplicate ids in COMPLETED.md (catches a random-id collision between
#      two independent worktree lanes; reroll with scripts/todo-done).
#   2. Every NEW id added to COMPLETED.md is cited by a `Completes:` trailer.
#   3. Every `Completes:` trailer references an id that exists in COMPLETED.md.

msg_file="$1"
msg=$(cat "$msg_file")

# --- 1. uniqueness ---------------------------------------------------------
dupes=$(git show :COMPLETED.md 2>/dev/null | grep -oE 'TODO-[0-9a-f]{6}' | sort | uniq -d)
if [ -n "$dupes" ]; then
  echo "✗ commit-msg: duplicate COMPLETED.md ids (random-id collision between lanes):"
  printf '%s\n' "$dupes" | sed 's/^/      /'
  echo "  Reroll the duplicate: revert its COMPLETED.md line and re-run scripts/todo-done."
  exit 1
fi

# --- compute new ids (staged minus HEAD) -----------------------------------
staged_ids=$(git show :COMPLETED.md 2>/dev/null | grep -oE 'TODO-[0-9a-f]{6}' | sort -u)
head_ids_file=$(mktemp)
git show HEAD:COMPLETED.md 2>/dev/null | grep -oE 'TODO-[0-9a-f]{6}' | sort -u > "$head_ids_file"
new_ids=$(printf '%s\n' "$staged_ids" | grep -vxF -f "$head_ids_file")
rm -f "$head_ids_file"

# --- 2. forward: new id must be cited --------------------------------------
missing=""
for id in $new_ids; do
  [ -z "$id" ] && continue
  printf '%s\n' "$msg" | grep -q "Completes: $id" || missing="$missing $id"
done
if [ -n "$missing" ]; then
  echo "✗ commit-msg: COMPLETED.md adds new item(s) with no 'Completes:' trailer:$missing"
  echo "  Add a trailer line for each, e.g.:  Completes:$missing"
  exit 1
fi

# --- 3. reverse: trailer must reference a real id --------------------------
all=" $(printf '%s\n' "$staged_ids" | tr '\n' ' ') "
refs=$(printf '%s\n' "$msg" | grep -oE 'Completes: TODO-[0-9a-f]{6}' | grep -oE 'TODO-[0-9a-f]{6}' | sort -u)
for ref in $refs; do
  case "$all" in
    *" $ref "*) : ;;
    *)
      echo "✗ commit-msg: 'Completes: $ref' references an id not present in COMPLETED.md."
      echo "  Fix the trailer or add the item to COMPLETED.md."
      exit 1 ;;
  esac
done

exit 0
