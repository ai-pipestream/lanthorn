#!/bin/sh
# Auto-append a `Completes: TODO-XXXX` trailer for every NEW id that this commit
# adds to COMPLETED.md, so the author rarely types the id by hand. The commit-msg
# hook then validates the file<->message link.

msg_file="$1"
src="$2"

# Don't touch merge/squash templates.
case "$src" in
  merge|squash) exit 0 ;;
esac

# Ids present in the staged (to-be-committed) COMPLETED.md.
staged_ids=$(git show :COMPLETED.md 2>/dev/null | grep -oE 'TODO-[0-9a-f]{6}' | sort -u)
[ -z "$staged_ids" ] && exit 0

# Ids already in the last commit's COMPLETED.md (empty if the file is new).
head_ids_file=$(mktemp)
git show HEAD:COMPLETED.md 2>/dev/null | grep -oE 'TODO-[0-9a-f]{6}' | sort -u > "$head_ids_file"

# new = staged minus head.
new_ids=$(printf '%s\n' "$staged_ids" | grep -vxF -f "$head_ids_file")
rm -f "$head_ids_file"
[ -z "$new_ids" ] && exit 0

appended=0
for id in $new_ids; do
  [ -z "$id" ] && continue
  grep -q "Completes: $id" "$msg_file" 2>/dev/null && continue
  if [ "$appended" -eq 0 ]; then printf '\n' >> "$msg_file"; appended=1; fi
  printf 'Completes: %s\n' "$id" >> "$msg_file"
done
exit 0
