# Dependencies / build output
/node_modules/
/package-lock.json
/package.json
/test_output.txt
/target/

# Local-only project files
/stories/

# Glulx/Glk conformance test story binaries (fetched, never committed — see
# unit_tests/README.md for the manifest + re-fetch recipe)
/unit_tests/*.ulx
/unit_tests/*.gblorb
/unit_tests/*.blb
/unit_tests/*.z5
# ...and the files those test games WRITE when the suite drives them
# (Glk external files, autosave/save-state dirs, generated blorbs)
/unit_tests/*.glkdata
/unit_tests/*.save/
/unit_tests/*.blorb

# Internal tooling / agent workspaces (machine-local, never committed)
/.claude/
/.worktrees/

# OS / editor junk (ignored anywhere in the tree)
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
/WAVE_REPORT.md
/.superpowers/
